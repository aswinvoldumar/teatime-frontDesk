---
import Badge from '../shared/Badge.astro';
import Button from '../shared/Button.astro';
import Icon from '../shared/Icon.astro';
import { Printer } from 'lucide-static';
import type { Order } from '../../types';
import {
  formatRelativeTime,
  orderStatusLabels,
  orderActionLabels,
  statusColors,
  priorityColors,
  actionButtonColors,
} from '../../utils/format';

interface Props {
  order: Order;
}

const { order } = Astro.props;
---

<article
  class="group bg-card border border-border rounded-[var(--radius-card)] p-4
         shadow-[var(--shadow-card)] card-lift flex flex-col h-full
         transition-all duration-200"
  data-order-card
  data-status={order.status}
  data-priority={order.priority}
  data-search={[
    order.id,
    order.customerName,
    order.tableNumber,
    ...order.items.map((i) => i.name),
  ].join(' ').toLowerCase()}
>
  <!-- Header -->
  <div class="flex items-start justify-between mb-3">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-body font-bold text-text">{order.id}</span>
        <span class="text-caption text-muted font-medium uppercase tracking-wide">
          Table {order.tableNumber}
        </span>
      </div>
      <p class="text-body font-semibold text-text">{order.customerName}</p>
    </div>
    <div class="flex flex-col items-end gap-1.5">
      <Badge color={statusColors[order.status]} variant="status">
        {orderStatusLabels[order.status]}
      </Badge>
      {(order.priority === 'high' || order.priority === 'urgent') && (
        <Badge color={priorityColors[order.priority]} variant="priority">
          {order.priority.charAt(0).toUpperCase() + order.priority.slice(1)}
        </Badge>
      )}
    </div>
  </div>

  <!-- Items -->
  <ul class="flex-1 space-y-1 mb-4" aria-label="Order items">
    {order.items.map((item) => (
      <li class="flex items-center gap-2 text-caption text-muted">
        <span class="w-1 h-1 rounded-full bg-muted shrink-0" />
        <span>
          {item.quantity > 1 && <span class="font-medium text-text">{item.quantity}× </span>}
          {item.name}
        </span>
      </li>
    ))}
  </ul>

  <!-- Footer -->
  <div class="flex items-center justify-between pt-3 border-t border-border mt-auto">
    <div class="flex items-center gap-2">
      <time class="text-caption text-muted" datetime={order.createdAt.toISOString()}>
        {formatRelativeTime(order.createdAt)}
      </time>
      {order.kitchenLabel && (
        <span class="text-caption px-1.5 py-0.5 rounded bg-background border border-border text-muted">
          {order.kitchenLabel}
        </span>
      )}
    </div>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        aria-label={`Print order ${order.id}`}
        class="w-8 h-8 rounded-lg flex items-center justify-center
               border border-border hover:bg-background transition-colors duration-200"
      >
        <Icon svg={Printer} class="w-3.5 h-3.5 text-muted" />
      </button>
      <Button
        size="sm"
        variant="primary"
        class={actionButtonColors[order.status]}
        ariaLabel={`${orderActionLabels[order.status]} order ${order.id}`}
      >
        {orderActionLabels[order.status]}
      </Button>
    </div>
  </div>
</article>
