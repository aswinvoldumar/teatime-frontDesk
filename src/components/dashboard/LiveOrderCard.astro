---
import Badge from '../shared/Badge.astro';
import Icon from '../shared/Icon.astro';
import { Clock } from 'lucide-static';
import type { Order } from '../../types';
import {
  formatRelativeTime,
  orderStatusLabels,
  orderActionLabels,
  statusColors,
  priorityColors,
  actionButtonColors,
} from '../../utils/format';

interface Props {
  order: Order;
}

const { order } = Astro.props;
const showPriority = order.priority === 'high' || order.priority === 'urgent';
---

<article
  class:list={[
    'panel-card p-3.5 flex flex-col h-full transition-all duration-200 hover:shadow-[var(--shadow-card-hover)]',
    order.status === 'new' && 'order-card-new',
  ]}
  data-order-card
  data-status={order.status}
  data-priority={order.priority}
  data-search={[
    order.id,
    order.customerName,
    order.tableNumber,
    ...order.items.map((i) => i.name),
  ].join(' ').toLowerCase()}
>
  <!-- Header: ID + inline badges -->
  <div class="flex items-center flex-wrap gap-1.5 mb-2">
    <span class="text-sm font-bold text-text">{order.id}</span>
    <span class="badge-table">Table {order.tableNumber}</span>
    {showPriority && (
      <Badge color={priorityColors[order.priority]} variant="priority" class="!text-[10px] !py-0 !px-1.5 !rounded-md">
        {order.priority.charAt(0).toUpperCase() + order.priority.slice(1)}
      </Badge>
    )}
    <Badge color={statusColors[order.status]} variant="status" class="!text-[10px] !py-0 !px-1.5 !rounded-md">
      {orderStatusLabels[order.status]}
    </Badge>
  </div>

  <p class="text-sm font-semibold text-text mb-2">{order.customerName}</p>

  <ul class="flex-1 space-y-0.5 mb-3" aria-label="Order items">
    {order.items.map((item) => (
      <li class="flex items-start gap-1.5 text-xs text-muted leading-snug">
        <span class="mt-1.5 w-1 h-1 rounded-full bg-muted/50 shrink-0" />
        <span>
          {item.quantity > 1 && <span class="font-medium text-text">{item.quantity}× </span>}
          {item.name}
        </span>
      </li>
    ))}
  </ul>

  <div class="flex items-center justify-between pt-2.5 border-t border-border mt-auto gap-2">
    <div class="flex items-center gap-1 text-[11px] text-muted">
      <Icon svg={Clock} class="w-3 h-3 shrink-0" />
      <time datetime={order.createdAt.toISOString()}>{formatRelativeTime(order.createdAt)}</time>
    </div>
    <button
      type="button"
      class:list={[
        'btn-primary px-3 py-1.5 text-xs font-semibold',
        actionButtonColors[order.status],
      ]}
      aria-label={`${orderActionLabels[order.status]} order ${order.id}`}
    >
      {orderActionLabels[order.status]}
    </button>
  </div>
</article>
