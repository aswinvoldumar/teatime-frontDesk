---
import Badge from '../shared/Badge.astro';
import Button from '../shared/Button.astro';
import Icon from '../shared/Icon.astro';
import { Printer } from 'lucide-static';
import type { Order } from '../../types';
import {
  formatRelativeTime,
  orderStatusLabels,
  orderActionLabels,
  statusColors,
  priorityColors,
  actionButtonColors,
} from '../../utils/format';

interface Props {
  order: Order;
}

const { order } = Astro.props;
const showPriority = order.priority === 'high' || order.priority === 'urgent';
---

<article
  class:list={[
    'group bg-card border border-border rounded-xl p-3 shadow-[var(--shadow-card)]',
    'flex flex-col h-full transition-all duration-200 hover:border-primary/25 hover:shadow-[var(--shadow-card-hover)]',
    order.status === 'new' && 'order-card-new',
  ]}
  data-order-card
  data-status={order.status}
  data-priority={order.priority}
  data-search={[
    order.id,
    order.customerName,
    order.tableNumber,
    ...order.items.map((i) => i.name),
  ].join(' ').toLowerCase()}
>
  <div class="flex items-start justify-between gap-2 mb-2">
    <div class="min-w-0">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-body font-bold text-text">{order.id}</span>
        <span class="text-[11px] text-muted font-medium uppercase tracking-wide">
          Table {order.tableNumber}
        </span>
      </div>
      <p class="text-body font-semibold text-text mt-0.5 truncate">{order.customerName}</p>
    </div>
    <div class="flex flex-col items-end gap-1 shrink-0">
      {showPriority && (
        <Badge color={priorityColors[order.priority]} variant="priority" class="!text-[10px] !py-0 !px-1.5">
          {order.priority.charAt(0).toUpperCase() + order.priority.slice(1)}
        </Badge>
      )}
      <Badge color={statusColors[order.status]} variant="status" class="!text-[10px] !py-0 !px-1.5">
        {orderStatusLabels[order.status]}
      </Badge>
    </div>
  </div>

  <ul class="flex-1 space-y-0.5 mb-2.5" aria-label="Order items">
    {order.items.map((item) => (
      <li class="flex items-center gap-1.5 text-caption text-muted leading-snug">
        <span class="w-1 h-1 rounded-full bg-muted/60 shrink-0" />
        <span class="truncate">
          {item.quantity > 1 && <span class="font-medium text-text">{item.quantity}× </span>}
          {item.name}
        </span>
      </li>
    ))}
  </ul>

  <div class="flex items-center justify-between pt-2 border-t border-border mt-auto gap-2">
    <time class="text-[11px] text-muted shrink-0" datetime={order.createdAt.toISOString()}>
      {formatRelativeTime(order.createdAt)}
    </time>
    <div class="flex items-center gap-1 shrink-0">
      <button
        type="button"
        aria-label={`Print order ${order.id}`}
        class="w-7 h-7 rounded-md flex items-center justify-center
               border border-border hover:bg-background dark:hover:bg-surface transition-colors"
      >
        <Icon svg={Printer} class="w-3 h-3 text-muted" />
      </button>
      <Button
        size="sm"
        variant="primary"
        class:list={[actionButtonColors[order.status], '!px-2.5 !py-1 !text-caption']}
        ariaLabel={`${orderActionLabels[order.status]} order ${order.id}`}
      >
        {orderActionLabels[order.status]}
      </Button>
    </div>
  </div>
</article>
