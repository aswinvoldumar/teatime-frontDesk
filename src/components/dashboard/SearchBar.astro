---
interface Props {
  placeholder?: string;
  id?: string;
  class?: string;
}

const { placeholder = 'Search...', id = 'search', class: className = '' } = Astro.props;

import Icon from '../shared/Icon.astro';
import { Search } from 'lucide-static';
---

<div class:list={['relative', className]}>
  <label for={id} class="sr-only">{placeholder}</label>
  <Icon
    svg={Search}
    class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none"
  />
  <input
    type="search"
    id={id}
    name={id}
    placeholder={placeholder}
    autocomplete="off"
    class="w-full pl-10 pr-4 py-2.5 text-body bg-input border border-border rounded-[var(--radius-button)]
           text-text placeholder:text-muted
           transition-all duration-200
           focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary
           dark:focus:ring-primary/30"
    data-search-input
  />
</div>
