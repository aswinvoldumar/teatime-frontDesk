---
interface Props {
  placeholder?: string;
  id?: string;
  class?: string;
}

const { placeholder = 'Search...', id = 'search', class: className = '' } = Astro.props;

import Icon from '../shared/Icon.astro';
import { Search } from 'lucide-static';
---

<div
  class:list={[
    'flex items-center w-full min-h-[42px] bg-input border border-border rounded-[var(--radius-button)]',
    'transition-all duration-200 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary',
    'dark:focus-within:ring-primary/30',
    className,
  ]}
>
  <label for={id} class="sr-only">{placeholder}</label>
  <span class="pl-3 flex items-center justify-center shrink-0 pointer-events-none text-muted" aria-hidden="true">
    <Icon svg={Search} class="w-4 h-4" />
  </span>
  <input
    type="search"
    id={id}
    name={id}
    placeholder={placeholder}
    autocomplete="off"
    class="flex-1 min-w-0 border-0 bg-transparent py-2.5 pl-2 pr-4 text-body leading-normal
           text-text placeholder:text-muted focus:outline-none"
    data-search-input
  />
</div>
