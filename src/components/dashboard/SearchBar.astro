---
interface Props {
  placeholder?: string;
  id?: string;
  class?: string;
  compact?: boolean;
}

const { placeholder = 'Search...', id = 'search', class: className = '', compact = false } = Astro.props;

import Icon from '../shared/Icon.astro';
import { Search } from 'lucide-static';
---

<div
  class:list={[
    'flex items-center w-full bg-input border border-border rounded-[var(--radius-button)]',
    'transition-all duration-200 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary',
    'dark:focus-within:ring-primary/30',
    compact ? 'min-h-[36px]' : 'min-h-[42px]',
    className,
  ]}
>
  <label for={id} class="sr-only">{placeholder}</label>
  <span class="pl-2.5 flex items-center justify-center shrink-0 pointer-events-none text-muted" aria-hidden="true">
    <Icon svg={Search} class="w-3.5 h-3.5" />
  </span>
  <input
    type="search"
    id={id}
    name={id}
    placeholder={placeholder}
    autocomplete="off"
    class:list={[
      'flex-1 min-w-0 border-0 bg-transparent pl-1.5 pr-3 text-text placeholder:text-muted focus:outline-none leading-normal',
      compact ? 'py-1.5 text-caption' : 'py-2.5 text-body',
    ]}
    data-search-input
  />
</div>
