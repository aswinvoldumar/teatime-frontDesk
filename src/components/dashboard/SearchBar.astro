---
interface Props {
  placeholder?: string;
  id?: string;
  class?: string;
}

const { placeholder = 'Search...', id = 'search', class: className = '' } = Astro.props;

import Icon from '../shared/Icon.astro';
import { Search } from 'lucide-static';
---

<div class:list={['input-field flex items-center w-full min-h-[38px]', className]}>
  <label for={id} class="sr-only">{placeholder}</label>
  <span class="pl-3 flex items-center justify-center shrink-0 pointer-events-none text-muted" aria-hidden="true">
    <Icon svg={Search} class="w-3.5 h-3.5" />
  </span>
  <input
    type="search"
    id={id}
    name={id}
    placeholder={placeholder}
    autocomplete="off"
    class="flex-1 min-w-0 border-0 bg-transparent py-2 pl-2 pr-3 text-xs text-text
           placeholder:text-muted focus:outline-none leading-normal"
    data-search-input
  />
</div>
