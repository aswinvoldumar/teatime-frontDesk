---
import SearchBar from './SearchBar.astro';
import LiveOrderCard from './LiveOrderCard.astro';
import EmptyState from '../shared/EmptyState.astro';
import Icon from '../shared/Icon.astro';
import { ChevronDown } from 'lucide-static';
import { orders } from '../../data/orders';

const statusTabs = ['all', 'new', 'preparing', 'ready', 'served'] as const;
const activeCount = orders.filter((o) => o.status !== 'served').length;
---

<section aria-label="Live orders" class="panel-card min-w-0 p-4 sm:p-5" data-orders-section>
  <!-- Header row -->
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between mb-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-semibold text-text">Live Orders</h2>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold
                     bg-primary/10 text-primary">
          {activeCount} active
        </span>
      </div>
      <p class="text-xs text-muted mt-0.5">Real-time queue across the floor</p>
    </div>

    <!-- Search + Priority aligned -->
    <div class="flex items-center gap-2 w-full lg:w-auto lg:shrink-0">
      <SearchBar
        placeholder="Search orders, tables, customers..."
        id="order-search"
        class="flex-1 lg:w-52"
      />
      <div class="relative shrink-0">
        <label for="order-filter" class="sr-only">Filter by priority</label>
        <select
          id="order-filter"
          data-order-filter
          class="input-field appearance-none min-h-[38px] pl-3 pr-8 py-2 text-xs
                 cursor-pointer focus:outline-none"
        >
          <option value="all">All Priorities</option>
          <option value="urgent">Urgent</option>
          <option value="high">High</option>
          <option value="normal">Normal</option>
          <option value="low">Low</option>
        </select>
        <span class="absolute right-2.5 inset-y-0 flex items-center pointer-events-none text-muted" aria-hidden="true">
          <Icon svg={ChevronDown} class="w-3.5 h-3.5" />
        </span>
      </div>
    </div>
  </div>

  <!-- Status tabs -->
  <div
    role="tablist"
    aria-label="Filter orders by status"
    class="flex gap-0.5 tab-track mb-4 overflow-x-auto scrollbar-thin"
    data-order-tabs
  >
    {statusTabs.map((tab) => (
      <button
        type="button"
        role="tab"
        aria-selected={tab === 'all' ? 'true' : 'false'}
        data-tab={tab}
        class:list={[
          'tab-pill',
          tab === 'all' && 'tab-pill-active',
        ]}
      >
        {tab.charAt(0).toUpperCase() + tab.slice(1)}
      </button>
    ))}
  </div>

  <!-- Orders grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3" data-orders-grid>
    {orders.map((order) => (
      <LiveOrderCard order={order} />
    ))}
  </div>

  <div data-orders-empty class="hidden">
    <EmptyState title="No orders found" description="Try adjusting your search or filter criteria." />
  </div>
</section>

<script>
  function initOrderFilters() {
    const section = document.querySelector('[data-orders-section]');
    if (!section) return;

    const searchInput = section.querySelector<HTMLInputElement>('[data-search-input]');
    const filterSelect = section.querySelector<HTMLSelectElement>('[data-order-filter]');
    const tabs = section.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const cards = section.querySelectorAll<HTMLElement>('[data-order-card]');
    const emptyState = section.querySelector<HTMLElement>('[data-orders-empty]');
    const grid = section.querySelector<HTMLElement>('[data-orders-grid]');

    let activeTab = 'all';

    function filterOrders() {
      const query = searchInput?.value.toLowerCase() ?? '';
      const priority = filterSelect?.value ?? 'all';
      let visible = 0;

      cards.forEach((card) => {
        const status = card.dataset.status ?? '';
        const cardPriority = card.dataset.priority ?? '';
        const searchText = card.dataset.search ?? '';

        const matchesTab = activeTab === 'all' || status === activeTab;
        const matchesPriority = priority === 'all' || cardPriority === priority;
        const matchesSearch = !query || searchText.includes(query);

        const show = matchesTab && matchesPriority && matchesSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (grid && emptyState) {
        grid.style.display = visible === 0 ? 'none' : '';
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', filterOrders);
    filterSelect?.addEventListener('change', filterOrders);

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeTab = tab.dataset.tab ?? 'all';
        tabs.forEach((t) => {
          const isActive = t.dataset.tab === activeTab;
          t.setAttribute('aria-selected', String(isActive));
          t.classList.toggle('tab-pill-active', isActive);
        });
        filterOrders();
      });
    });

    section.addEventListener('click', (e) => {
      const printBtn = (e.target as HTMLElement).closest('[data-print-order]');
      if (!printBtn) return;

      const card = printBtn.closest('[data-order-card]');
      if (!card) return;

      const clone = card.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('[data-print-order], .btn-primary').forEach((el) => el.remove());

      const printWindow = window.open('', '_blank', 'width=480,height=640');
      if (!printWindow) return;

      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
          <head>
            <title>Order Receipt</title>
            <style>
              body { font-family: Inter, sans-serif; padding: 24px; color: #0f172a; }
              ul { padding-left: 16px; margin: 8px 0; }
              li { margin: 4px 0; font-size: 13px; }
            </style>
          </head>
          <body>${clone.innerHTML}</body>
        </html>
      `);
      printWindow.document.close();
      printWindow.focus();
      printWindow.print();
      printWindow.close();
    });
  }

  initOrderFilters();
  document.addEventListener('astro:page-load', initOrderFilters);
</script>
