---
import SearchBar from './SearchBar.astro';
import OrderCard from './OrderCard.astro';
import EmptyState from '../shared/EmptyState.astro';
import Icon from '../shared/Icon.astro';
import { ChevronDown } from 'lucide-static';
import { orders } from '../../data/orders';

const statusTabs = ['all', 'new', 'preparing', 'ready', 'served'] as const;
const activeCount = orders.filter((o) => o.status !== 'served').length;
---

<section aria-label="Live orders" class="min-w-0" data-orders-section>
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="text-section-title font-semibold text-text">Live Orders</h2>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-caption font-semibold
                     bg-primary/10 text-primary">
          {activeCount} active
        </span>
      </div>
      <p class="text-caption text-muted mt-0.5">Monitor and manage incoming orders in real-time</p>
    </div>
  </div>

  <!-- Controls -->
  <div class="flex flex-col sm:flex-row gap-3 mb-4">
    <SearchBar
      placeholder="Search orders, tables, customers..."
      id="order-search"
      class="flex-1"
    />

    <div class="relative shrink-0">
      <label for="order-filter" class="sr-only">Filter by priority</label>
      <select
        id="order-filter"
        data-order-filter
        class="appearance-none w-full sm:w-44 pl-3 pr-9 py-2.5 text-body
               bg-input border border-border rounded-[var(--radius-button)] text-text
               focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary
               transition-all duration-200 cursor-pointer"
      >
        <option value="all">All Priorities</option>
        <option value="urgent">Urgent</option>
        <option value="high">High</option>
        <option value="normal">Normal</option>
        <option value="low">Low</option>
      </select>
      <Icon svg={ChevronDown} class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none" />
    </div>
  </div>

  <!-- Status Tabs -->
  <div
    role="tablist"
    aria-label="Filter orders by status"
    class="flex gap-1 p-1 tab-track bg-background border border-border rounded-xl mb-5 overflow-x-auto scrollbar-thin"
    data-order-tabs
  >
    {statusTabs.map((tab) => (
      <button
        type="button"
        role="tab"
        aria-selected={tab === 'all' ? 'true' : 'false'}
        data-tab={tab}
        class:list={[
          'px-3.5 py-1.5 rounded-lg text-caption font-medium whitespace-nowrap transition-all duration-200',
          tab === 'all'
            ? 'tab-active bg-card text-text shadow-sm border border-border'
            : 'text-muted hover:text-text',
        ]}
      >
        {tab.charAt(0).toUpperCase() + tab.slice(1)}
      </button>
    ))}
  </div>

  <!-- Orders Grid -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"
    data-orders-grid
  >
    {orders.map((order) => (
      <OrderCard order={order} />
    ))}
  </div>

  <div data-orders-empty class="hidden">
    <EmptyState
      title="No orders found"
      description="Try adjusting your search or filter criteria."
    />
  </div>
</section>

<script>
  function initOrderFilters() {
    const section = document.querySelector('[data-orders-section]');
    if (!section) return;

    const searchInput = section.querySelector<HTMLInputElement>('[data-search-input]');
    const filterSelect = section.querySelector<HTMLSelectElement>('[data-order-filter]');
    const tabs = section.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const cards = section.querySelectorAll<HTMLElement>('[data-order-card]');
    const emptyState = section.querySelector<HTMLElement>('[data-orders-empty]');
    const grid = section.querySelector<HTMLElement>('[data-orders-grid]');

    let activeTab = 'all';

    function filterOrders() {
      const query = searchInput?.value.toLowerCase() ?? '';
      const priority = filterSelect?.value ?? 'all';
      let visible = 0;

      cards.forEach((card) => {
        const status = card.dataset.status ?? '';
        const cardPriority = card.dataset.priority ?? '';
        const searchText = card.dataset.search ?? '';

        const matchesTab = activeTab === 'all' || status === activeTab;
        const matchesPriority = priority === 'all' || cardPriority === priority;
        const matchesSearch = !query || searchText.includes(query);

        const show = matchesTab && matchesPriority && matchesSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (grid && emptyState) {
        grid.style.display = visible === 0 ? 'none' : '';
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', filterOrders);
    filterSelect?.addEventListener('change', filterOrders);

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeTab = tab.dataset.tab ?? 'all';
        tabs.forEach((t) => {
          const isActive = t.dataset.tab === activeTab;
          t.setAttribute('aria-selected', String(isActive));
          t.classList.toggle('tab-active', isActive);
          t.classList.toggle('bg-card', isActive);
          t.classList.toggle('text-text', isActive);
          t.classList.toggle('shadow-sm', isActive);
          t.classList.toggle('border', isActive);
          t.classList.toggle('border-border', isActive);
          t.classList.toggle('text-muted', !isActive);
        });
        filterOrders();
      });
    });
  }

  initOrderFilters();
  document.addEventListener('astro:page-load', initOrderFilters);
</script>
