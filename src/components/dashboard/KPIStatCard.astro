---
import Icon from '../shared/Icon.astro';
import { TrendingUp, TrendingDown } from 'lucide-static';
import type { KPI } from '../../types';
import * as LucideIcons from 'lucide-static';

interface Props {
  kpi: KPI;
}

const { kpi } = Astro.props;
const isPositive = kpi.trend >= 0;
const iconSvg = (LucideIcons as Record<string, string>)[kpi.icon] ?? LucideIcons.Activity;
---

<div class="kpi-stat-card p-4 transition-all duration-200 hover:shadow-[var(--shadow-card-hover)]">
  <div class="flex items-start justify-between gap-3 mb-3 relative z-10">
    <p class="text-[11px] font-semibold text-muted uppercase tracking-widest leading-none pt-1">
      {kpi.title}
    </p>
    <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
      <Icon svg={iconSvg} class="w-4 h-4 text-primary" />
    </div>
  </div>

  <p class="text-[40px] font-bold text-text tracking-tight leading-none mb-1 relative z-10">
    {kpi.value}
  </p>
  <p class="text-xs text-muted mb-2 relative z-10">{kpi.description}</p>

  <div class:list={[
    'inline-flex items-center gap-1 text-[11px] font-medium relative z-10',
    isPositive ? 'text-green-600 dark:text-emerald-400' : 'text-red-500 dark:text-red-400',
  ]}>
    <Icon svg={isPositive ? TrendingUp : TrendingDown} class="w-3 h-3" />
    <span>{isPositive ? '+' : ''}{kpi.trend}% {kpi.trendLabel}</span>
  </div>
</div>
