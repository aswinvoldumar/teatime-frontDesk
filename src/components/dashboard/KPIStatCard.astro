---
import Icon from '../shared/Icon.astro';
import { TrendingUp, TrendingDown } from 'lucide-static';
import type { KPI } from '../../types';
import * as LucideIcons from 'lucide-static';

interface Props {
  kpi: KPI;
}

const { kpi } = Astro.props;
const isPositive = kpi.trend >= 0;
const iconSvg = (LucideIcons as Record<string, string>)[kpi.icon] ?? LucideIcons.Activity;
---

<div class="kpi-stat-card group bg-card border border-border rounded-xl p-3.5
            shadow-[var(--shadow-card)] relative overflow-hidden transition-all duration-200
            hover:border-primary/20 hover:shadow-[var(--shadow-card-hover)]">
  <div class="flex items-start justify-between gap-2 mb-2">
    <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0
                transition-transform duration-200 group-hover:scale-105">
      <Icon svg={iconSvg} class="w-4 h-4 text-primary" />
    </div>
    <div class:list={[
      'flex items-center gap-0.5 text-[11px] font-medium px-1.5 py-0.5 rounded-full shrink-0',
      isPositive
        ? 'bg-green-50 text-green-700 dark:bg-emerald-500/10 dark:text-emerald-400'
        : 'bg-red-50 text-red-700 dark:bg-red-500/10 dark:text-red-400',
    ]}>
      <Icon svg={isPositive ? TrendingUp : TrendingDown} class="w-3 h-3" />
      <span>{isPositive ? '+' : ''}{kpi.trend}%</span>
    </div>
  </div>

  <p class="text-[11px] font-medium text-muted uppercase tracking-wider leading-none mb-1">{kpi.title}</p>
  <p class="text-2xl font-bold text-text tracking-tight leading-tight mb-0.5">{kpi.value}</p>
  <p class="text-caption text-muted leading-snug">{kpi.description}</p>
  <p class="text-[10px] text-muted/80 mt-1">{kpi.trendLabel}</p>
</div>
