---
import KPIStatCard from './KPIStatCard.astro';
import { kpiData } from '../../data/kpi';
---

<section aria-label="Key performance indicators" class="mb-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {kpiData.map((kpi) => (
      <KPIStatCard kpi={kpi} />
    ))}
  </div>
</section>
