---
import Icon from '../shared/Icon.astro';
import { TrendingUp, TrendingDown } from 'lucide-static';
import type { KPI } from '../../types';
import * as LucideIcons from 'lucide-static';

interface Props {
  kpi: KPI;
}

const { kpi } = Astro.props;
const isPositive = kpi.trend >= 0;
const iconSvg = (LucideIcons as Record<string, string>)[kpi.icon] ?? LucideIcons.Activity;

const chartBars = [40, 65, 45, 80, 55, 90, 70];
---

<div class="group bg-card border border-border rounded-[var(--radius-card)] p-5
            shadow-[var(--shadow-card)] card-lift relative overflow-hidden">
  <div class="flex items-start justify-between mb-4">
    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center
                transition-transform duration-200 group-hover:scale-110">
      <Icon svg={iconSvg} class="w-5 h-5 text-primary" />
    </div>
    <div class:list={[
      'flex items-center gap-1 text-caption font-medium px-2 py-0.5 rounded-full',
      isPositive
        ? 'bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-400'
        : 'bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-400',
    ]}>
      <Icon svg={isPositive ? TrendingUp : TrendingDown} class="w-3 h-3" />
      <span>{Math.abs(kpi.trend)}%</span>
    </div>
  </div>

  <p class="text-caption font-medium text-muted uppercase tracking-wider mb-1">{kpi.title}</p>
  <p class="text-kpi-metric font-bold text-text tracking-tight mb-1">{kpi.value}</p>
  <p class="text-caption text-muted">{kpi.description}</p>

  <!-- Mini chart placeholder -->
  <div class="mt-4 flex items-end gap-1 h-8 opacity-60 group-hover:opacity-100 transition-opacity">
    {chartBars.map((height) => (
      <div
        class="flex-1 rounded-sm bg-primary/20 group-hover:bg-primary/40 transition-colors duration-200"
        style={`height: ${height}%`}
      />
    ))}
  </div>

  <p class="text-[10px] text-muted mt-2">{kpi.trendLabel}</p>
</div>
