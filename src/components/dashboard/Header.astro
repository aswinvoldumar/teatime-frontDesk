---
import ThemeToggle from './ThemeToggle.astro';
import NotificationDropdown from './NotificationDropdown.astro';
import { restaurant, currentUser } from '../../data/user';
import { formatDate } from '../../utils/format';
import logo from '../../assets/images/Logo.png';

const today = formatDate(new Date());
---

<header class="sticky top-0 z-40 header-bar">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      <!-- Left: Logo -->
      <div class="flex items-center gap-3 min-w-0">
        <a href="/" class="flex items-center gap-3 min-w-0 shrink-0" aria-label={restaurant.name}>
          <img
            src={logo.src}
            alt={restaurant.name}
            width={logo.width}
            height={logo.height}
            class="h-12 w-auto object-contain"
            loading="eager"
            decoding="async"
          />
          <p class="text-caption header-text-muted hidden md:block">{today}</p>
        </a>
      </div>

      <!-- Right: Clock, Notifications, Theme, User -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="hidden md:flex flex-col items-end mr-1 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10">
          <time id="live-clock" class="text-body font-mono font-medium header-text tabular-nums" datetime="">
            --:--:-- --
          </time>
       
        </div>

        <NotificationDropdown darkHeader />
        <ThemeToggle darkHeader />

        <div
          class="flex items-center gap-2.5 pl-1.5 pr-3 py-1.5 rounded-full
                 bg-white/5 border border-white/10 min-w-0"
          aria-label={`${currentUser.name}, ${currentUser.role}`}
        >
          <div
            class="w-9 h-9 rounded-full bg-[#5c3d2e]
                   flex items-center justify-center text-white text-xs font-bold shrink-0"
            aria-hidden="true"
          >
            {currentUser.initials}
          </div>
          <div class="hidden sm:block min-w-0 leading-tight">
            <p class="text-sm font-semibold header-text truncate">{currentUser.name}</p>
            <p class="text-xs header-text-muted truncate">{currentUser.role}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function initClock() {
    const clock = document.getElementById('live-clock');
    if (!clock) return;

    function update() {
      const now = new Date();
      clock!.textContent = now.toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true,
      });
      clock!.setAttribute('datetime', now.toISOString());
    }

    update();
    setInterval(update, 1000);
  }

  initClock();
  document.addEventListener('astro:page-load', initClock);
</script>
