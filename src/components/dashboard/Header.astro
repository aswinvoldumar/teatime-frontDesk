---
import ThemeToggle from './ThemeToggle.astro';
import NotificationDropdown from './NotificationDropdown.astro';
import { restaurant, currentUser } from '../../data/user';
import { formatDate } from '../../utils/format';

const today = formatDate(new Date());
---

<header class="sticky top-0 z-40 glass">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Left: Mobile menu + Logo -->
      <div class="flex items-center gap-3 min-w-0">
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-label="Open navigation menu"
          aria-expanded="false"
          class="lg:hidden w-9 h-9 rounded-lg flex items-center justify-center
                 bg-background border border-border hover:bg-surface transition-colors"
        >
          <svg class="w-5 h-5 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <div class="flex items-center gap-3 min-w-0">
          <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center shrink-0 shadow-sm">
            <span class="text-white font-bold text-sm">{restaurant.logo}</span>
          </div>
          <div class="min-w-0 hidden sm:block">
            <h1 class="text-body font-semibold text-text truncate">{restaurant.name}</h1>
            <p class="text-caption text-muted">{today}</p>
          </div>
        </div>
      </div>

      <!-- Right: Clock, Notifications, Theme, User -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="hidden md:flex flex-col items-end mr-1">
          <time id="live-clock" class="text-body font-mono font-medium text-text tabular-nums" datetime="">
            --:--:-- --
          </time>
          <span class="text-caption text-muted uppercase tracking-wider">Local</span>
        </div>

        <NotificationDropdown />
        <ThemeToggle />

        <div class="flex items-center gap-2.5 pl-2 sm:pl-3 border-l border-border">
          <div
            class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-orange-600
                   flex items-center justify-center text-white text-xs font-semibold shrink-0"
            aria-hidden="true"
          >
            {currentUser.initials}
          </div>
          <div class="hidden sm:block min-w-0">
            <p class="text-body font-medium text-text truncate">{currentUser.name}</p>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium
                         bg-primary/10 text-primary uppercase tracking-wide">
              {currentUser.role}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function initClock() {
    const clock = document.getElementById('live-clock');
    if (!clock) return;

    function update() {
      const now = new Date();
      clock!.textContent = now.toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true,
      });
      clock!.setAttribute('datetime', now.toISOString());
    }

    update();
    setInterval(update, 1000);
  }

  initClock();
  document.addEventListener('astro:page-load', initClock);
</script>
