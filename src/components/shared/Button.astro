---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger' | 'success';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  disabled = false,
  ariaLabel,
} = Astro.props;

const variants = {
  primary: 'bg-primary hover:bg-primary-hover text-white shadow-sm dark:shadow-[0_0_16px_rgb(249_115_22_/_0.25)]',
  secondary: 'bg-surface border border-border hover:bg-background text-text',
  ghost: 'hover:bg-background text-muted hover:text-text',
  danger: 'bg-red-600 hover:bg-red-700 text-white',
  success: 'bg-green-600 hover:bg-green-700 text-white',
};

const sizes = {
  sm: 'px-2.5 py-1 text-caption rounded-md gap-1',
  md: 'px-3.5 py-2 text-body rounded-[var(--radius-button)] gap-1.5',
  lg: 'px-5 py-2.5 text-body rounded-[var(--radius-button)] gap-2',
};
---

<button
  type={type}
  disabled={disabled}
  aria-label={ariaLabel}
  class:list={[
    'inline-flex items-center justify-center font-medium transition-all duration-200',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
    'disabled:opacity-50 disabled:cursor-not-allowed',
    'active:scale-[0.98]',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</button>
