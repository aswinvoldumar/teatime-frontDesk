---
interface Props {
  variant?: 'default' | 'status' | 'priority';
  color?: string;
  class?: string;
}

const { variant = 'default', color, class: className = '' } = Astro.props;

const variants = {
  default: 'bg-background text-muted border border-border',
  status: color ?? 'bg-background text-muted border border-border',
  priority: color ?? 'bg-background text-muted border border-border',
};
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 rounded-md text-caption font-medium',
    'border transition-colors duration-200',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
