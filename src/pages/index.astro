---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import KPISection from '../components/dashboard/KPISection.astro';
import LiveOrdersSection from '../components/dashboard/LiveOrdersSection.astro';
import WaiterRequestPanel from '../components/dashboard/WaiterRequestPanel.astro';
---

<DashboardLayout title="Dashboard">
  <div class="dashboard-grid">
    <div class="dashboard-main min-w-0 space-y-4">
      <div>
        <h1 class="text-lg font-bold text-text tracking-tight">Front Desk</h1>
        <p class="text-xs text-muted mt-0.5">Real-time overview of restaurant operations</p>
      </div>
      <KPISection />
      <LiveOrdersSection />
    </div>
    <WaiterRequestPanel />
  </div>
</DashboardLayout>
