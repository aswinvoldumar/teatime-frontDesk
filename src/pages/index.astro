---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import KPISection from '../components/dashboard/KPISection.astro';
import LiveOrdersSection from '../components/dashboard/LiveOrdersSection.astro';
import WaiterRequestPanel from '../components/dashboard/WaiterRequestPanel.astro';
---

<DashboardLayout title="Dashboard">
  <div class="dashboard-grid">
    <!-- Left column: KPIs + Live Orders (70%) -->
    <div class="dashboard-main min-w-0">
      <div class="mb-4">
        <h1 class="text-xl font-bold text-text tracking-tight">Front Desk</h1>
        <p class="text-caption text-muted mt-0.5">Real-time overview of restaurant operations</p>
      </div>
      <KPISection />
      <LiveOrdersSection />
    </div>

    <!-- Right column: Waiter Requests (30%) -->
    <WaiterRequestPanel />
  </div>
</DashboardLayout>
